---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<section class="cta" aria-labelledby="cta-h">
  <div class="ring r1" aria-hidden="true"></div>
  <div class="ring r2" aria-hidden="true"></div>
  <div class="container cta-inner">
    <div class="cta-copy">
      <h2 id="cta-h" class="h2">Ready to Take the Next Step?</h2>
      <p>
        Call or text us at {site.phone} to schedule your free in-home estimate. We’ll answer your questions and get you
        on the schedule.
      </p>
      <ul class="checks">
        <li><Icon name="check" size={18} stroke={2.5} />Free estimates</li>
        <li><Icon name="check" size={18} stroke={2.5} />Family-owned</li>
        <li><Icon name="check" size={18} stroke={2.5} />Homes &amp; businesses</li>
      </ul>
    </div>
    <div class="btn-row">
      <a href={`tel:${site.phoneRaw}`} class="btn btn-navy"><Icon name="phone" size={18} /> Call {site.phone}</a>
      <a href={`sms:${site.phoneRaw}`} class="btn btn-cream"><Icon name="chat" size={18} /> Text Us</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    background: var(--sky);
    color: var(--navy);
  }
  .ring {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .r1 {
    right: -120px;
    top: -160px;
    width: 460px;
    height: 460px;
    border: 2px solid rgba(0, 20, 41, 0.1);
  }
  .r2 {
    left: -140px;
    bottom: -220px;
    width: 420px;
    height: 420px;
    border: 2px solid rgba(254, 251, 238, 0.35);
  }
  .cta-inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px 56px;
    padding-block: 80px;
  }
  .cta-copy {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .cta-copy .h2 {
    font-size: clamp(38px, 4.4vw, 56px);
  }
  .cta-copy p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--navy-soft);
    max-width: 600px;
  }
  .checks {
    font-size: 14px;
    font-weight: 700;
    gap: 10px 22px;
  }
</style>
