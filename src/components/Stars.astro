---
import Icon from './Icon.astro';

interface Props {
  size?: number;
}
const { size = 18 } = Astro.props;
---

<span class="stars" role="img" aria-label="Five stars">
  {Array.from({ length: 5 }).map(() => <Icon name="star" size={size} />)}
</span>

<style>
  .stars {
    display: inline-flex;
    gap: 3px;
    color: var(--orange);
  }
</style>
